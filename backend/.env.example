APP_NAME=Starter API
APP_ENV=dev
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-at-least-32-random-characters-please
APP_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
APP_REDIS_URL=redis://localhost:6379/0
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_REFRESH_TOKEN_EXPIRE_DAYS=14
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
# Optional: created at start-up (and by scripts/create_superuser.py) when both are set
APP_FIRST_SUPERUSER_EMAIL=admin@example.com
APP_FIRST_SUPERUSER_PASSWORD=admin12345
