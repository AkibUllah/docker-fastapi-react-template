# Compose-level variables (copy to .env). Service-specific ones live in backend/.env.example
# and frontend/.env.example.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

APP_SECRET_KEY=change-me-to-at-least-32-random-characters-please
APP_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Production image tags (docker-compose.prod.yml)
IMAGE_REGISTRY=ghcr.io/akibullah/docker-fastapi-react-template
IMAGE_TAG=latest
PUBLIC_PORT=80
