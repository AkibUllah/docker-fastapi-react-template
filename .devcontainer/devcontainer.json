{
  "name": "docker-fastapi-react-template",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "containerEnv": {
    "APP_FIRST_SUPERUSER_EMAIL": "admin@example.com",
    "APP_FIRST_SUPERUSER_PASSWORD": "Admin12345"
  },
  "postCreateCommand": "cp -n .env.example .env; pip install --upgrade pip && pip install -r backend/requirements-dev.txt && cd frontend && npm ci --no-audit --no-fund",
  "postStartCommand": "docker compose up -d --build",
  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": {
      "label": "App (nginx: SPA + /api)",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "API docs (/api/v1/docs)",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite dev server (use 8080 instead)",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "Postgres",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
